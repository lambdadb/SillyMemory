{
  "name": "sillymemory",
  "version": "0.4.0",
  "private": true,
  "description": "Long-term memory for SillyTavern.",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check:release": "node scripts/check-release.mjs",
    "test:install": "node scripts/install-smoke.mjs",
    "check": "node --check index.js && node --check src/chat-collections.js && node --check src/checkpoints.js && node --check src/client.js && node --check src/commit.js && node --check src/chunking.js && node --check src/context.js && node --check src/memory.js && node --check src/gate.js && node --check src/status.js && node --check src/delivery.js",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:faults": "node scripts/browser-smoke.mjs --faults",
    "test:collections:live": "node scripts/chat-collections-live.mjs",
    "test:live": "node scripts/chat-collections-live.mjs",
    "test:live:faults": "node scripts/chat-collections-live.mjs --checkpoint-recovery",
    "test:generation": "node scripts/generation-smoke.mjs",
    "test:generation:live": "node scripts/generation-smoke.mjs --live-model",
    "test:korean:live": "node scripts/generation-smoke.mjs --korean-eval",
    "test:comparison:live": "node scripts/generation-smoke.mjs --comparison",
    "test:heldout:live": "node scripts/generation-smoke.mjs --heldout",
    "test:recovery": "node scripts/browser-smoke.mjs --recovery",
    "test:challenges:live": "node scripts/generation-smoke.mjs --challenges",
    "test:natural:live": "node scripts/generation-smoke.mjs --natural",
    "build:sdk": "node scripts/build-sdk.mjs",
    "check:sdk": "node scripts/build-sdk.mjs --check"
  },
  "engines": {
    "node": ">=20.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "esbuild": "0.28.2"
  },
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lambdadb/SillyMemory.git"
  },
  "dependencies": {
    "@functional-systems/lambdadb": "0.7.0-dev.37433431398001"
  }
}
